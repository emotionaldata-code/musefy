# Runtime credentials only. Never commit .env.
POSTGRES_USER=musefy
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=musefy
# Local uv commands; Compose overrides hostname with postgres.
DATABASE_URL=postgresql+asyncpg://musefy:replace-with-a-local-password@localhost:5432/musefy
TMDB_READ_ACCESS_TOKEN=replace-with-tmdb-read-access-token
TMDB_RPS=10
# TVmaze public API needs no key; shared pacing across healer processes.
TVMAZE_RPS=1
# Public Jikan service was discontinued; Tenrai serves a compatible schema.
# You can also set the URL of your own Jikan instance.
JIKAN_BASE_URL=https://api.tenrai.org/v1
JIKAN_INTERVAL=1.1
CONCURRENCY=2
HTTP_TIMEOUT=30
HTTP_RETRIES=3
# Google OAuth web client: backend only; never use VITE_ for these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
AUTH_FRONTEND_URL=http://127.0.0.1:5173
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_JWT_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=604800
CORS_ORIGINS=["http://127.0.0.1:5173"]
# Dedicated, disposable database; tests truncate its catalog tables.
TEST_DATABASE_URL=postgresql+asyncpg://musefy:test-only@127.0.0.1:55432/musefy_test
