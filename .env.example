# Runtime credentials only. Never commit .env.
POSTGRES_USER=musefy
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=musefy
# Local uv commands; Compose overrides hostname with postgres.
DATABASE_URL=postgresql+asyncpg://musefy:replace-with-a-local-password@localhost:5432/musefy
TMDB_READ_ACCESS_TOKEN=replace-with-tmdb-read-access-token
TMDB_RPS=10
# Public Jikan service was discontinued; Tenrai serves a compatible schema.
# You can also set the URL of your own Jikan instance.
JIKAN_BASE_URL=https://api.tenrai.org/v1
JIKAN_INTERVAL=1.1
CONCURRENCY=2
HTTP_TIMEOUT=30
HTTP_RETRIES=3
# Dedicated, disposable database; tests truncate its catalog tables.
TEST_DATABASE_URL=postgresql+asyncpg://musefy:test-only@127.0.0.1:55432/musefy_test
