# systemd EnvironmentFile: absolute paths, no shell expansion.
MUSEFY_PROJECT=/absolute/path/to/musefy
MUSEFY_RUNTIME=/absolute/path/to/embedding-runtime
MUSEFY_DEVICE=cuda
MUSEFY_SSH_HOST=ssh.edia-company.com
MUSEFY_DATABASE_CONTAINER=musefy-production-6pe27w-postgres-1
MUSEFY_TUNNEL_PORT=55433
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:55433/musefy
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
HF_HUB_DISABLE_PROGRESS_BARS=1
